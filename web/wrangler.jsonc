{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revision",
  "compatibility_date": "2026-08-20",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "TELEMETRY_KV",
      "id": "d7eaf80fde4b4c16bd8a0671035471d6"
    }
  ],
  "routes": [
    { "pattern": "revision.altrusian.com", "custom_domain": true },
    { "pattern": "an.altrusian.com", "custom_domain": true }
  ]
}
