{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sutra",
  "compatibility_date": "2026-08-20",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/healthz",
      "/data/*",
      "/assets/*"
    ]
  },
  "routes": [
    { "pattern": "revision.altrusian.com", "custom_domain": true }
  ]
}
